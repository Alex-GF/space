# -----------------------------------------------------
# Rate limiting zones
# -----------------------------------------------------

# REST API rate limit
# 15 requests/sec sustained per IP
limit_req_zone $binary_remote_addr zone=space_api_limit:10m rate=15r/s;

# WebSocket concurrent connections
limit_conn_zone $binary_remote_addr zone=space_ws_limit:10m;

# Optional: explicit 429 status
limit_req_status 429;

# =====================================================
# HTTPS SERVER
# =====================================================

server {

    listen 5403;
    client_max_body_size 100M;

    large_client_header_buffers 8 64k;
    client_header_buffer_size 64k;

    # =================================================
    # API
    # =================================================

    location ${BASE_URL_PATH}/api/ {

        # ---------------------------------------------
        # Rate limiting
        # ---------------------------------------------

        limit_req zone=space_api_limit burst=40 nodelay;

        include             fastcgi_params;
        proxy_pass          http://space-server:3000/api/;
        proxy_redirect      off;

        proxy_connect_timeout 500;
        proxy_read_timeout 500;

        proxy_set_header    Host            $host;
        proxy_set_header    X-Real-IP       $remote_addr;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # =================================================
    # STATIC FILES
    # =================================================

    location ${BASE_URL_PATH}/static/ {

        include             fastcgi_params;
        proxy_pass          http://space-server:3000/static/;
        proxy_redirect      off;

        proxy_connect_timeout 500;
        proxy_read_timeout 500;

        proxy_set_header    Host            $host;
        proxy_set_header    X-Real-IP       $remote_addr;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # =================================================
    # EVENTS / WEBSOCKETS
    # =================================================

    location ${BASE_URL_PATH}/events/ {

        # ---------------------------------------------
        # WebSocket connection limiting
        # ---------------------------------------------

        limit_conn space_ws_limit 5;

        include             fastcgi_params;
        proxy_pass          http://space-server:3000/events/;
        proxy_redirect      off;

        proxy_connect_timeout 500;
        proxy_read_timeout 500;

        proxy_set_header    Host            $host;
        proxy_set_header    X-Real-IP       $remote_addr;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_http_version  1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # =================================================
    # FRONTEND
    # =================================================

    location ${BASE_URL_PATH}/ {

        include             fastcgi_params;
        proxy_pass          http://space-client:5050/;
        proxy_redirect      off;

        proxy_connect_timeout 500;
        proxy_read_timeout 500;

        proxy_set_header    Host            $host;
        proxy_set_header    X-Real-IP       $remote_addr;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
